# NeuralPulse Trading - Environment Configuration
# Copy this file to .env and fill in your values.

# Telegram Channel / Bot Signal Configuration (Get token from @BotFather)
# For a channel, use your channel username (e.g. @my_trading_signals) or numeric chat_id (e.g. -1001234567890)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_channel_or_chat_id_here
# Optional: if your ISP blocks api.telegram.org, set a proxy or custom API mirror URL
# TELEGRAM_PROXY_URL=http://127.0.0.1:7890
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# CryptoPanic API Key (Optional — falls back to live Crypto RSS + NLTK VADER NLP if omitted)
CRYPTOPANIC_API_KEY=your_api_key_here

# Fundamental Confirmation Mode:
# Set REQUIRE_POSITIVE_FUNDAMENTALS=true if you only want BUY when sentiment > 0.05 (and SELL when < -0.05)
# Default (false) uses the protective threshold: BUY when sentiment > -0.10, SELL when sentiment < 0.10
REQUIRE_POSITIVE_FUNDAMENTALS=false

# Signal Cooldown (minutes) to prevent duplicate alerts on consecutive candles in the same direction
SIGNAL_COOLDOWN_MINUTES=60

# Paper Trading Capital (USD) & Risk per Trade (%)
INITIAL_CAPITAL=10000.0
MAX_RISK_PER_TRADE_PCT=2.0

# Market Mode & Binance Futures Signal Settings
TRADING_MARKET_TYPE=FUTURES
MAX_FUTURES_LEVERAGE=10
MIN_SL_PCT=0.005
EXTREME_FUNDING_RATE=0.0005

# Pluggable Local NLP Engine: vader (default) | finbert (requires transformers + torch)
SENTIMENT_ENGINE=vader

# Exchange (default: binance)
EXCHANGE_ID=binance
